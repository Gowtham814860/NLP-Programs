   "source": [
    "from textblob import TextBlob\n",
    "\n",
    "text = \"I love Python programming\"\n",
    "\n",
    "analysis = TextBlob(text)\n",
    "\n",
    "if analysis.sentiment.polarity > 0:\n",
    "    print(\"Positive Sentiment\")\n",
    "else:\n",
    "    print(\"Negative Sentiment\")\n"
   ]
