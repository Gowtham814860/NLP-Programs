   "source": [
    "import re\n",
    "\n",
    "text = \"Contact john@gmail.com and admin@yahoo.com\"\n",
    "\n",
    "emails = re.findall(r'\\S+@\\S+', text)\n",
    "\n",
    "for email in emails:\n",
    "    print(email.split('@')[0])\n"
   ]
